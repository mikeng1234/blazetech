# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Discord webhook used by /api/notify to alert you on visitor actions
# (call, email, maps, quote, facebook, messenger).
# Create at: Discord server > Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME
